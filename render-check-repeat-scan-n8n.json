          {
            "node": "Scan for repeats",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Scan for repeats": {
      "main": [
        [
          {
            "node": "Return candidates for review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
